__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
dist/
build/

# bc7enc native build intermediates. The vendored sources are checked
# in under native/bc7enc/, but cl.exe leaves .obj/.exp/.lib/.dll there
# during builds. The "shipped" DLL is src/furrifier/facegen/_bc7enc.dll,
# copied there by native/build_bc7enc.cmd.
native/bc7enc/*.obj
native/bc7enc/*.exp
native/bc7enc/*.lib
native/bc7enc/*.dll

# Generated by furrify_skyrim.spec at build time (commit + timestamp
# baked into the frozen kit). Never checked in — it would go stale and
# make dev runs claim to be a release build.
src/furrifier/_build_stamp.py
